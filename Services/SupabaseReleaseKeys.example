// SupabaseReleaseKeys.swift
//
// Copy this file to SupabaseReleaseKeys.swift and replace the placeholder values
// with your Supabase project credentials.
//
// The anon key is a PUBLIC publishable key. Never include the service-role key.

#if !DEBUG
enum SupabaseReleaseKeys {
    static let url = "https://YOUR_PROJECT_REF.supabase.co"
    static let anonKey = "YOUR_ANON_KEY_HERE"
}
#endif
